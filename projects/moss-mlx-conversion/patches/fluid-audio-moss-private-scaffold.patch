index 0000000..4d5c31a
--- /dev/null
+++ b/Sources/FluidAudio/ASR/MOSS/MossBundleManifest.swift
@@ -0,0 +1,101 @@
+import Foundation
+
+public struct MossBundleManifest: Decodable, Sendable {
+    public struct Artifacts: Decodable, Sendable {
+        public let tokenPackagePath: String?
+        public let audioPackagePath: String?
+        public let prefillCachePackagePath: String?
+        public let stepPackagePath: String?
+        public let tokenizerPath: String?
+        public let runtimeManifestPath: String?
+
+        enum CodingKeys: String, CodingKey {
+            case tokenPackagePath = "token_package_path"
+            case audioPackagePath = "audio_package_path"
+            case prefillCachePackagePath = "prefill_cache_package_path"
+            case stepPackagePath = "step_package_path"
+            case tokenizerPath = "tokenizer_path"
+            case runtimeManifestPath = "runtime_manifest_path"
+        }
+    }
+
+    public struct CachePreset: Decodable, Sendable {
+        public let name: String
+        public let aliases: [String]?
+        public let description: String?
+        public let status: String?
+        public let prefillCachePackagePath: String
+        public let prefillCacheSeqLen: Int
+        public let stepPackagePath: String
+        public let cacheLen: Int
+        public let maxTotalPositions: Int?
+
+        enum CodingKeys: String, CodingKey {
+            case name
+            case aliases
+            case description
+            case status
+            case prefillCachePackagePath = "prefill_cache_package_path"
+            case prefillCacheSeqLen = "prefill_cache_seq_len"
+            case stepPackagePath = "step_package_path"
+            case cacheLen = "cache_len"
+            case maxTotalPositions = "max_total_positions"
+        }
+
+        public func matches(_ rawValue: String) -> Bool {
+            name == rawValue || (aliases ?? []).contains(rawValue)
+        }
+    }
+
+    public static let defaultFileName = "moss_bundle_manifest.json"
+
+    public let version: Int
+    public let defaultCachePreset: String?
+    public let artifacts: Artifacts
+    public let cachePresets: [CachePreset]
+
+    enum CodingKeys: String, CodingKey {
+        case version
+        case defaultCachePreset = "default_cache_preset"
+        case artifacts
+        case cachePresets = "cache_presets"
+    }
+
+    public static func load(from url: URL) throws -> MossBundleManifest {
+        try JSONDecoder().decode(MossBundleManifest.self, from: try Data(contentsOf: url))
+    }
+
+    public func cachePreset(named rawValue: String) -> CachePreset? {
+        cachePresets.first { $0.matches(rawValue) }
+    }
+}
+
+public extension MossAsrConfig {
+    mutating func apply(artifacts: MossBundleManifest.Artifacts) {
+        if let value = artifacts.tokenPackagePath {
+            tokenPackagePath = value
+        }
+        if let value = artifacts.audioPackagePath {
+            audioPackagePath = value
+        }
+        if let value = artifacts.prefillCachePackagePath {
+            prefillCachePackagePath = value
+        }
+        if let value = artifacts.stepPackagePath {
+            stepPackagePath = value
+        }
+        if let value = artifacts.tokenizerPath {
+            tokenizerPath = value
+        }
+        if let value = artifacts.runtimeManifestPath {
+            runtimeManifestPath = value
+        }
+    }
+
+    mutating func apply(cachePreset: MossBundleManifest.CachePreset) {
+        prefillCachePackagePath = cachePreset.prefillCachePackagePath
+        prefillCacheSeqLen = cachePreset.prefillCacheSeqLen
+        stepPackagePath = cachePreset.stepPackagePath
+        cacheLen = cachePreset.cacheLen
+    }
+}
diff --git a/Sources/FluidAudio/ASR/MOSS/MossModels.swift b/Sources/FluidAudio/ASR/MOSS/MossModels.swift
new file mode 100644
index 0000000..fdee2a9
--- /dev/null
+++ b/Sources/FluidAudio/ASR/MOSS/MossModels.swift
@@ -0,0 +1,54 @@
+@preconcurrency import CoreML
+import Foundation
+
+@available(macOS 14, iOS 17, *)
+public struct MossModels: Sendable {
+    public let tokenModel: MLModel
+    public let audioModel: MLModel
+    public let prefillCacheModel: MLModel
+    public let stepModel: MLModel
+    public let modelDirectory: URL
+
+    let runtimeManifest: MossRuntimeManifest
+    let tokenizer: QwenByteLevelTokenizer
+
+    public static func load(
+        from modelDirectory: URL,
+        tokenizerURL: URL? = nil,
+        runtimeManifestURL: URL? = nil,
+        config: MossAsrConfig = .default
+    ) throws -> MossModels {
+        let mlConfig = MLModelConfiguration()
+        mlConfig.computeUnits = config.computeUnits
+
+        let tokenURL = modelDirectory.appendingPathComponent(config.tokenPackagePath)
+        let audioURL = modelDirectory.appendingPathComponent(config.audioPackagePath)
+        let prefillURL = modelDirectory.appendingPathComponent(config.prefillCachePackagePath)
+        let stepURL = modelDirectory.appendingPathComponent(config.stepPackagePath)
+        let resolvedTokenizerURL =
+            tokenizerURL ?? modelDirectory.appendingPathComponent(config.tokenizerPath)
+        let resolvedManifestURL =
+            runtimeManifestURL ?? modelDirectory.appendingPathComponent(config.runtimeManifestPath)
+
+        for url in [tokenURL, audioURL, prefillURL, stepURL, resolvedTokenizerURL, resolvedManifestURL] {
+            guard FileManager.default.fileExists(atPath: url.path) else {
+                throw MossAsrError.modelNotFound(url.path)
+            }
+        }
+
+        let manifest = try JSONDecoder().decode(
+            MossRuntimeManifest.self,
+            from: try Data(contentsOf: resolvedManifestURL)
+        )
+
+        return MossModels(
+            tokenModel: try MLModel(contentsOf: tokenURL, configuration: mlConfig),
+            audioModel: try MLModel(contentsOf: audioURL, configuration: mlConfig),
+            prefillCacheModel: try MLModel(contentsOf: prefillURL, configuration: mlConfig),
+            stepModel: try MLModel(contentsOf: stepURL, configuration: mlConfig),
+            modelDirectory: modelDirectory,
+            runtimeManifest: manifest,
+            tokenizer: try QwenByteLevelTokenizer(tokenizerJSON: resolvedTokenizerURL)
+        )
+    }
+}

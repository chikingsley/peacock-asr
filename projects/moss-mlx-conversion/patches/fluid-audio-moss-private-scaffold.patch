+@preconcurrency import CoreML
+import Darwin
+import Foundation
+
+public struct MossGenerationTiming: Codable, Sendable {
+    public let audioFrontend: Double
+    public let tokenEmbeddingPrompt: Double
+    public let audioEncoderAdapter: Double
+    public let decoderPrefill: Double
+    public let tokenEmbeddingDecode: Double
+    public let decoderDecode: Double
+
+    public var total: Double {
+        audioFrontend + tokenEmbeddingPrompt + audioEncoderAdapter + decoderPrefill
+            + tokenEmbeddingDecode + decoderDecode
+    }
+}
+
+public struct MossTranscriptionResult: Codable, Sendable {
+    public let text: String
+    public let normalizedText: String
+    public let tokenIds: [Int]
+    public let promptLength: Int
+    public let audioTokenCount: Int
+    public let audioDuration: Double
+    public let processingTime: Double
+    public let stoppedOnEos: Bool
+    public let timing: MossGenerationTiming
+
+    public var rtfx: Double {
+        audioDuration / max(processingTime, 1.0e-9)
+    }
+}
+
+@available(macOS 14, iOS 17, *)
+public actor MossAsrManager {
+    private let models: MossModels
+    private let config: MossAsrConfig
+
+    public init(models: MossModels, config: MossAsrConfig = .default) {
+        self.models = models
+        self.config = config
+    }
+
+    public static func load(
+        from modelDirectory: URL,
+        tokenizerURL: URL? = nil,
+        runtimeManifestURL: URL? = nil,
+        config: MossAsrConfig = .default
+    ) throws -> MossAsrManager {
+        let models = try MossModels.load(
+            from: modelDirectory,
+            tokenizerURL: tokenizerURL,
+            runtimeManifestURL: runtimeManifestURL,
+            config: config
+        )
+        return MossAsrManager(models: models, config: config)
+    }
+
+    public func transcribe(audioURL: URL) async throws -> ASRResult {
+        let samples = try MossAudioFile.loadMono16k(url: audioURL)
+        let result = try await transcribeSamples(samples, source: audioURL.path)
+        return ASRResult(
+            text: result.text,
+            confidence: 0,
+            duration: result.audioDuration,
+            processingTime: result.processingTime,
+            tokenTimings: nil,
+            performanceMetrics: nil
+        )
+    }
+
+    public func transcribe(audio: [Float]) async throws -> ASRResult {
+        let result = try await transcribeSamples(audio, source: "samples")
+        return ASRResult(
+            text: result.text,
+            confidence: 0,
+            duration: result.audioDuration,
+            processingTime: result.processingTime,
+            tokenTimings: nil,
+            performanceMetrics: nil
+        )
+    }
+
+    public func transcribeDetailed(audioURL: URL) async throws -> MossTranscriptionResult {
+        let samples = try MossAudioFile.loadMono16k(url: audioURL)
+        return try await transcribeSamples(samples, source: audioURL.path)
+    }
+
+    public func transcribeDetailed(audio: [Float]) async throws -> MossTranscriptionResult {
+        try await transcribeSamples(audio, source: "samples")
+    }
+
+    private func transcribeSamples(_ samples: [Float], source: String) async throws -> MossTranscriptionResult {
+        let rowStart = DispatchTime.now().uptimeNanoseconds
+        let audioDuration = Double(samples.count) / 16_000.0
+
+        let frontendStart = DispatchTime.now().uptimeNanoseconds
+        let frontend = try WhisperLogMelFrontend()
+        var audioFeatures = try frontend.compute(samples: samples, source: source)
+        audioFeatures = try padAudioFeatures(audioFeatures, frames: config.audioMaxFrames)
+        let audioFrontendSeconds = secondsSince(frontendStart)
+
+        guard let audioFrameCount = audioFeatures.seqlens.first else {
+            throw MossAsrError.invalidArgument("audio_data_seqlens is empty")
+        }
+        let audioTokenCount = mossAudioTokenCount(melFrames: Int(audioFrameCount))
+        let prompt = try buildPrompt(
+            manifest: models.runtimeManifest,
+            audioTokenCount: audioTokenCount
+        )
+        guard prompt.promptLen <= config.prefillCacheSeqLen else {
+            throw MossAsrError.invalidArgument(
+                "prompt length \(prompt.promptLen) exceeds prefill bucket \(config.prefillCacheSeqLen)"
+            )
+        }
+        guard config.maxNewTokens > 0 else {
+            throw MossAsrError.invalidArgument("maxNewTokens must be positive")
+        }
+        guard config.prefillCacheSeqLen <= config.cacheLen else {
+            throw MossAsrError.invalidArgument(
+                "prefill bucket \(config.prefillCacheSeqLen) exceeds cache length \(config.cacheLen)"
+            )
+        }
+        let requiredCacheLen = prompt.promptLen + max(0, config.maxNewTokens - 1)
+        guard requiredCacheLen <= config.cacheLen else {
+            throw MossAsrError.invalidArgument(
+                "prompt length \(prompt.promptLen) plus max generated cache positions "
+                    + "\(max(0, config.maxNewTokens - 1)) requires cache length "
+                    + "\(requiredCacheLen), but cache length is \(config.cacheLen)"
+            )
+        }
+
+        let tokenInput = try MLDictionaryFeatureProvider(dictionary: [
+            "input_ids": MLFeatureValue(
+                multiArray: try paddedIds(prompt.inputIds, maxSeqLen: config.tokenMaxSeqLen)
+            )
+        ])
+        let (tokenOutput, tokenSeconds) = try await timedPrediction(
+            model: models.tokenModel,
+            input: tokenInput
+        )
+        let tokenEmbeddings = try featureArray(tokenOutput, "token_embeddings")
+
+        let audioInput = try MLDictionaryFeatureProvider(dictionary: [
+            "audio_data": MLFeatureValue(
+                multiArray: try makeFloatArray(shape: audioFeatures.shape, values: audioFeatures.data)
+            ),
+            "audio_data_seqlens": MLFeatureValue(
+                multiArray: try makeIntArray(shape: [1], values: audioFeatures.seqlens)
+            ),
+        ])
+        let (audioOutput, audioSeconds) = try await timedPrediction(
+            model: models.audioModel,
+            input: audioInput
+        )
+        let audioEmbeddings = try featureArray(audioOutput, "audio_embeddings")
+        let mergedEmbeddings = try buildMergedEmbeddings(
+            tokenEmbeddings: tokenEmbeddings,
+            audioEmbeddings: audioEmbeddings,
+            manifest: models.runtimeManifest,
+            prompt: prompt
+        )
+
+        let prefillFeatures = try MLDictionaryFeatureProvider(dictionary: [
+            "inputs_embeds": MLFeatureValue(
+                multiArray: try padMergedEmbeddings(
+                    mergedEmbeddings,
+                    promptLen: prompt.promptLen,
+                    seqLen: config.prefillCacheSeqLen,
+                    hiddenSize: models.runtimeManifest.hiddenSize
+                )
+            ),
+            "last_token_mask": MLFeatureValue(
+                multiArray: try buildLastTokenMask(
+                    promptLen: prompt.promptLen,
+                    seqLen: config.prefillCacheSeqLen
+                )
+            ),
+        ])
+        let (prefillOutput, prefillSeconds) = try await timedPrediction(
+            model: models.prefillCacheModel,
+            input: prefillFeatures
+        )
+        let prefillTopK = try topK(featureArray(prefillOutput, "logits"))
+        guard let firstGenerated = prefillTopK.first?.index else {
+            throw MossAsrError.invalidArgument("prefill produced no finite logits")
+        }
+
+        var generatedIds = [firstGenerated]
+        var stoppedOnEos = firstGenerated == config.eosTokenId
+        var currentToken = Int32(firstGenerated)
+        var pastKeys = try padDecoderCache(
+            try featureArray(prefillOutput, "past_keys"),
+            cacheLen: config.cacheLen,
+            featureName: "past_keys"
+        )
+        var pastValues = try padDecoderCache(
+            try featureArray(prefillOutput, "past_values"),
+            cacheLen: config.cacheLen,
+            featureName: "past_values"
+        )
+
+        var decodeTokenSeconds = 0.0
+        var decodeStepSeconds = 0.0
+        for stepIndex in 0..<max(0, config.maxNewTokens - 1) where !stoppedOnEos {
+            let tokenInput = try MLDictionaryFeatureProvider(dictionary: [
+                "input_ids": MLFeatureValue(
+                    multiArray: try paddedIds([currentToken], maxSeqLen: config.tokenMaxSeqLen)
+                )
+            ])
+            let (tokenOutput, tokenDecodeSeconds) = try await timedPrediction(
+                model: models.tokenModel,
+                input: tokenInput
+            )
+            decodeTokenSeconds += tokenDecodeSeconds
+            let tokenEmbedding = try firstTokenEmbedding(
+                try featureArray(tokenOutput, "token_embeddings"),
+                hiddenSize: models.runtimeManifest.hiddenSize
+            )
+
+            let stepPosition = prompt.promptLen + stepIndex
+            let (stepCos, stepSin) = try buildRope(
+                length: 1,
+                start: stepPosition,
+                headDim: models.runtimeManifest.headDim,
+                ropeTheta: models.runtimeManifest.ropeTheta
+            )
+            let masks = try buildPaddedStepInputs(
+                cacheLen: config.cacheLen,
+                pastLen: stepPosition
+            )
+            let stepInput = try MLDictionaryFeatureProvider(dictionary: [
+                "inputs_embeds": MLFeatureValue(multiArray: tokenEmbedding),
+                "past_keys": MLFeatureValue(multiArray: pastKeys),
+                "past_values": MLFeatureValue(multiArray: pastValues),
+                "cache_update_mask": MLFeatureValue(multiArray: masks.cacheUpdateMask),
+                "attention_mask": MLFeatureValue(multiArray: masks.attentionMask),
+                "cos": MLFeatureValue(multiArray: stepCos),
+                "sin": MLFeatureValue(multiArray: stepSin),
+            ])
+            let (stepOutput, stepSeconds) = try await timedPrediction(
+                model: models.stepModel,
+                input: stepInput
+            )
+            decodeStepSeconds += stepSeconds
+            let stepTopK = try topK(featureArray(stepOutput, "logits"))
+            guard let nextToken = stepTopK.first?.index else {
+                throw MossAsrError.invalidArgument("decode step produced no finite logits")
+            }
+            generatedIds.append(nextToken)
+            if nextToken == config.eosTokenId {
+                stoppedOnEos = true
+            }
+            currentToken = Int32(nextToken)
+            pastKeys = try featureArray(stepOutput, "updated_keys")
+            pastValues = try featureArray(stepOutput, "updated_values")
+        }
+
+        let text = models.tokenizer.decode(generatedIds)
+        let timing = MossGenerationTiming(
+            audioFrontend: audioFrontendSeconds,
+            tokenEmbeddingPrompt: tokenSeconds,
+            audioEncoderAdapter: audioSeconds,
+            decoderPrefill: prefillSeconds,
+            tokenEmbeddingDecode: decodeTokenSeconds,
+            decoderDecode: decodeStepSeconds
+        )
+        return MossTranscriptionResult(
+            text: text,
+            normalizedText: normalizedTranscript(text),
+            tokenIds: generatedIds,
+            promptLength: prompt.promptLen,
+            audioTokenCount: prompt.audioTokenCount,
+            audioDuration: audioDuration,
+            processingTime: secondsSince(rowStart),
+            stoppedOnEos: stoppedOnEos,
+            timing: timing
+        )
+    }
+}
+
+private struct TopKEntry {
+    let index: Int
+    let value: Float
+}
+
+private func secondsSince(_ start: UInt64) -> Double {
+    Double(DispatchTime.now().uptimeNanoseconds - start) / 1_000_000_000.0
+}
+
+private func buildPrompt(
+    manifest: MossRuntimeManifest,
+    audioTokenCount: Int
+) throws -> MossPrompt {
+    guard audioTokenCount >= 0 else {
+        throw MossAsrError.invalidArgument("audio token count must be non-negative")
+    }
+    let inputIds = manifest.promptPrefixIds
+        + [Int32](repeating: manifest.audioPlaceholderId, count: audioTokenCount)
+        + manifest.promptSuffixIds
+    let audioInputMask = [Bool](repeating: false, count: manifest.promptPrefixIds.count)
+        + [Bool](repeating: true, count: audioTokenCount)
+        + [Bool](repeating: false, count: manifest.promptSuffixIds.count)
+    return MossPrompt(inputIds: inputIds, audioInputMask: audioInputMask)
+}
+
+private func makeFloatArray(shape: [Int], values: [Float]? = nil) throws -> MLMultiArray {
+    let array = try MLMultiArray(shape: shape.map { NSNumber(value: $0) }, dataType: .float32)
+    let pointer = array.dataPointer.bindMemory(to: Float.self, capacity: array.count)
+    if let values {
+        guard values.count == array.count else {
+            throw MossAsrError.invalidArgument("value count \(values.count) != array count \(array.count)")
+        }
+        values.withUnsafeBufferPointer { source in
+            pointer.update(from: source.baseAddress!, count: values.count)
+        }
+    } else {
+        for index in 0..<array.count {
+            pointer[index] = 0
+        }
+    }
+    return array
+}
+
+private func makeIntArray(shape: [Int], values: [Int32]) throws -> MLMultiArray {
+    let array = try MLMultiArray(shape: shape.map { NSNumber(value: $0) }, dataType: .int32)
+    guard values.count == array.count else {
+        throw MossAsrError.invalidArgument("value count \(values.count) != array count \(array.count)")
+    }
+    let pointer = array.dataPointer.bindMemory(to: Int32.self, capacity: array.count)
+    values.withUnsafeBufferPointer { source in
+        pointer.update(from: source.baseAddress!, count: values.count)
+    }
+    return array
+}
+
+private func paddedIds(_ ids: [Int32], maxSeqLen: Int) throws -> MLMultiArray {
+    guard ids.count <= maxSeqLen else {
+        throw MossAsrError.invalidArgument("ids length \(ids.count) exceeds \(maxSeqLen)")
+    }
+    var padded = [Int32](repeating: 0, count: maxSeqLen)
+    for (index, value) in ids.enumerated() {
+        padded[index] = value
+    }
+    return try makeIntArray(shape: [1, maxSeqLen], values: padded)
+}
+
+private func featureArray(_ provider: MLFeatureProvider, _ name: String) throws -> MLMultiArray {
+    guard let array = provider.featureValue(for: name)?.multiArrayValue else {
+        throw MossAsrError.missingFeature(name)
+    }
+    return array
+}
+
+private func strides(_ array: MLMultiArray) -> [Int] {
+    array.strides.map(\.intValue)
+}
+
+private func offset(_ indices: [Int], strides: [Int]) -> Int {
+    zip(indices, strides).reduce(0) { partial, pair in
+        partial + pair.0 * pair.1
+    }
+}
+
+private func floatValue(_ array: MLMultiArray, _ indices: [Int]) -> Float {
+    let storageIndex = offset(indices, strides: strides(array))
+    switch array.dataType {
+    case .float32:
+        return array.dataPointer.bindMemory(to: Float.self, capacity: array.count)[storageIndex]
+    case .float16:
+        return Float(array.dataPointer.bindMemory(to: Float16.self, capacity: array.count)[storageIndex])
+    case .double:
+        return Float(array.dataPointer.bindMemory(to: Double.self, capacity: array.count)[storageIndex])
+    default:
+        return array[indices.map { NSNumber(value: $0) }].floatValue
+    }
+}
+
+private func setFloat(_ array: MLMultiArray, _ indices: [Int], _ value: Float) {
+    let storageIndex = offset(indices, strides: strides(array))
+    array.dataPointer.bindMemory(to: Float.self, capacity: array.count)[storageIndex] = value
+}
+
+private func shapeInts(_ array: MLMultiArray) -> [Int] {
+    array.shape.map(\.intValue)
+}
+
+private func padDecoderCache(_ cache: MLMultiArray, cacheLen: Int, featureName: String) throws -> MLMultiArray {
+    let shape = shapeInts(cache)
+    guard shape.count == 5 else {
+        throw MossAsrError.invalidArgument("\(featureName) must have rank 5, got \(shape)")
+    }
+    let pastLen = shape[3]
+    guard cacheLen >= pastLen else {
+        throw MossAsrError.invalidArgument(
+            "cache-len \(cacheLen) is shorter than \(featureName) prompt length \(pastLen)"
+        )
+    }
+    if cacheLen == pastLen {
+        return cache
+    }
+    let padded = try makeFloatArray(
+        shape: [shape[0], shape[1], shape[2], cacheLen, shape[4]]
+    )
+
+    let cacheStrides = strides(cache)
+    let paddedStrides = strides(padded)
+    if cache.dataType == .float32,
+        padded.dataType == .float32,
+        cacheStrides[4] == 1,
+        paddedStrides[4] == 1
+    {
+        let source = cache.dataPointer.bindMemory(to: Float.self, capacity: cache.count)
+        let target = padded.dataPointer.bindMemory(to: Float.self, capacity: padded.count)
+        let headDim = shape[4]
+
+        if cacheStrides[3] == headDim, paddedStrides[3] == headDim {
+            let blockCount = pastLen * headDim
+            for layer in 0..<shape[0] {
+                for batch in 0..<shape[1] {
+                    for head in 0..<shape[2] {
+                        let sourceOffset = offset([layer, batch, head, 0, 0], strides: cacheStrides)
+                        let targetOffset = offset([layer, batch, head, 0, 0], strides: paddedStrides)
+                        target.advanced(by: targetOffset).update(
+                            from: source.advanced(by: sourceOffset),
+                            count: blockCount
+                        )
+                    }
+                }
+            }
+            return padded
+        }
+
+        for layer in 0..<shape[0] {
+            for batch in 0..<shape[1] {
+                for head in 0..<shape[2] {
+                    for position in 0..<pastLen {
+                        let sourceOffset = offset(
+                            [layer, batch, head, position, 0],
+                            strides: cacheStrides
+                        )
+                        let targetOffset = offset(
+                            [layer, batch, head, position, 0],
+                            strides: paddedStrides
+                        )
+                        target.advanced(by: targetOffset).update(
+                            from: source.advanced(by: sourceOffset),
+                            count: headDim
+                        )
+                    }
+                }
+            }
+        }
+        return padded
+    }
+
+    for layer in 0..<shape[0] {
+        for batch in 0..<shape[1] {
+            for head in 0..<shape[2] {
+                for position in 0..<pastLen {
+                    for dim in 0..<shape[4] {
+                        setFloat(
+                            padded,
+                            [layer, batch, head, position, dim],
+                            floatValue(cache, [layer, batch, head, position, dim])
+                        )
+                    }
+                }
+            }
+        }
+    }
+    return padded
+}
+
+private func buildPaddedStepInputs(cacheLen: Int, pastLen: Int) throws -> (
+    cacheUpdateMask: MLMultiArray, attentionMask: MLMultiArray
+) {
+    guard pastLen >= 0, pastLen < cacheLen else {
+        throw MossAsrError.invalidArgument("past length \(pastLen) is outside cache-len \(cacheLen)")
+    }
+    let cacheUpdateMask = try makeFloatArray(shape: [1, 1, cacheLen, 1])
+    setFloat(cacheUpdateMask, [0, 0, pastLen, 0], 1)
+
+    let attentionMask = try makeFloatArray(shape: [1, 1, 1, cacheLen])
+    for position in 0..<cacheLen {
+        setFloat(attentionMask, [0, 0, 0, position], position <= pastLen ? 0 : -1_000_000_000.0)
+    }
+    return (cacheUpdateMask, attentionMask)
+}
+
+private func buildMergedEmbeddings(
+    tokenEmbeddings: MLMultiArray,
+    audioEmbeddings: MLMultiArray,
+    manifest: MossRuntimeManifest,
+    prompt: MossPrompt
+) throws -> MLMultiArray {
+    let merged = try makeFloatArray(shape: [1, prompt.promptLen, manifest.hiddenSize])
+    var audioIndex = 0
+    for position in 0..<prompt.promptLen {
+        let sourceIsAudio = prompt.audioInputMask[position]
+        for hidden in 0..<manifest.hiddenSize {
+            let value: Float
+            if sourceIsAudio {
+                value = floatValue(audioEmbeddings, [audioIndex, hidden])
+            } else {
+                value = floatValue(tokenEmbeddings, [0, position, hidden])
+            }
+            setFloat(merged, [0, position, hidden], value)
+        }
+        if sourceIsAudio {
+            audioIndex += 1
+        }
+    }
+    guard audioIndex == prompt.audioTokenCount else {
+        throw MossAsrError.invalidArgument(
+            "merged \(audioIndex) audio embeddings but prompt expects \(prompt.audioTokenCount)"
+        )
+    }
+    return merged
+}
+
+private func padMergedEmbeddings(
+    _ mergedEmbeddings: MLMultiArray,
+    promptLen: Int,
+    seqLen: Int,
+    hiddenSize: Int
+) throws -> MLMultiArray {
+    guard seqLen >= promptLen else {
+        throw MossAsrError.invalidArgument(
+            "prefill cache seq len \(seqLen) is shorter than prompt length \(promptLen)"
+        )
+    }
+    let padded = try makeFloatArray(shape: [1, seqLen, hiddenSize])
+    for position in 0..<promptLen {
+        for hidden in 0..<hiddenSize {
+            setFloat(
+                padded,
+                [0, position, hidden],
+                floatValue(mergedEmbeddings, [0, position, hidden])
+            )
+        }
+    }
+    return padded
+}
+
+private func buildLastTokenMask(promptLen: Int, seqLen: Int) throws -> MLMultiArray {
+    guard promptLen >= 1, promptLen <= seqLen else {
+        throw MossAsrError.invalidArgument(
+            "prompt length \(promptLen) is outside prefill cache seq len \(seqLen)"
+        )
+    }
+    let mask = try makeFloatArray(shape: [1, seqLen, 1])
+    setFloat(mask, [0, promptLen - 1, 0], 1)
+    return mask
+}
+
+private func firstTokenEmbedding(_ tokenEmbeddings: MLMultiArray, hiddenSize: Int) throws -> MLMultiArray {
+    let tokenEmbedding = try makeFloatArray(shape: [1, 1, hiddenSize])
+    for hidden in 0..<hiddenSize {
+        setFloat(
+            tokenEmbedding,
+            [0, 0, hidden],
+            floatValue(tokenEmbeddings, [0, 0, hidden])
+        )
+    }
+    return tokenEmbedding
+}
+
+private func buildRope(length: Int, start: Int, headDim: Int, ropeTheta: Double) throws -> (
+    cos: MLMultiArray, sin: MLMultiArray
+) {
+    let cosArray = try makeFloatArray(shape: [1, length, headDim])
+    let sinArray = try makeFloatArray(shape: [1, length, headDim])
+    let half = headDim / 2
+    for localPosition in 0..<length {
+        let position = Double(start + localPosition)
+        for index in 0..<half {
+            let exponent = Double(2 * index) / Double(headDim)
+            let angle = position / pow(ropeTheta, exponent)
+            let cosine = Float(Darwin.cos(angle))
+            let sine = Float(Darwin.sin(angle))
+            setFloat(cosArray, [0, localPosition, index], cosine)
+            setFloat(cosArray, [0, localPosition, index + half], cosine)
+            setFloat(sinArray, [0, localPosition, index], sine)
+            setFloat(sinArray, [0, localPosition, index + half], sine)
+        }
+    }
+    return (cosArray, sinArray)
+}
+
+private func topK(_ logits: MLMultiArray, count: Int = 5) throws -> [TopKEntry] {
+    var winners: [TopKEntry] = []
+    for index in 0..<logits.count {
+        let value: Float
+        switch logits.dataType {
+        case .float32:
+            value = logits.dataPointer.bindMemory(to: Float.self, capacity: logits.count)[index]
+        case .float16:
+            value = Float(logits.dataPointer.bindMemory(to: Float16.self, capacity: logits.count)[index])
+        case .double:
+            value = Float(logits.dataPointer.bindMemory(to: Double.self, capacity: logits.count)[index])
+        default:
+            value = logits[index].floatValue
+        }
+        if !value.isFinite {
+            continue
+        }
+        winners.append(TopKEntry(index: index, value: value))
+        winners.sort { $0.value > $1.value }
+        if winners.count > count {
+            winners.removeLast()
+        }
+    }
+    return winners
+}
+
+private func timedPrediction(
+    model: MLModel,
+    input: MLFeatureProvider
+) async throws -> (MLFeatureProvider, Double) {
+    let start = DispatchTime.now().uptimeNanoseconds
+    let output = try await model.prediction(from: input)
+    return (output, secondsSince(start))
+}

+#if os(macOS)
+enum MossCachePreset {
+    static func apply(
+        _ rawValue: String,
+        prefillCachePackagePath: inout String?,
+        prefillCacheSeqLen: inout Int,
+        stepPackagePath: inout String?,
+        cacheLen: inout Int
+    ) -> Bool {
+        switch rawValue {
+        case "short-512", "cache-512", "512":
+            prefillCachePackagePath = "compiled_prefill_cache_512/moss_decoder_prefill_cache_512.mlmodelc"
+            prefillCacheSeqLen = 512
+            stepPackagePath = "compiled_step_padded_512/moss_decoder_step_padded_512.mlmodelc"
+            cacheLen = 512
+            return true
+        case "compat-768", "cache-768", "768":
+            prefillCachePackagePath = "compiled_prefill_cache_512/moss_decoder_prefill_cache_512.mlmodelc"
+            prefillCacheSeqLen = 512
+            stepPackagePath = "compiled_step_padded/moss_decoder_step_padded_fixture.mlmodelc"
+            cacheLen = 768
+            return true
+        case "matched-768":
+            prefillCachePackagePath = "compiled_prefill_cache_768/moss_decoder_prefill_cache_768.mlmodelc"
+            prefillCacheSeqLen = 768
+            stepPackagePath = "compiled_step_padded/moss_decoder_step_padded_fixture.mlmodelc"
+            cacheLen = 768
+            return true
+        default:
+            return false
+        }
+    }
+
+    static let usage = """
+        short-512  512-token prefill plus 512-cache step. Fastest validated short-row path.
+        compat-768 512-token prefill plus 768-cache step. Default compatibility path.
+        matched-768 768-token prefill plus 768-cache step. Experimental; currently MPSGraph-blocked.
+        """
+}
+#endif
diff --git a/Sources/FluidAudioCLI/Commands/ASR/MOSS/MossConfigResolver.swift b/Sources/FluidAudioCLI/Commands/ASR/MOSS/MossConfigResolver.swift
new file mode 100644
index 0000000..c22828b
--- /dev/null
+++ b/Sources/FluidAudioCLI/Commands/ASR/MOSS/MossConfigResolver.swift
@@ -0,0 +1,124 @@
+#if os(macOS)
+import CoreML
+import FluidAudio
+import Foundation
+
+struct MossPackageOverrides {
+    var tokenPackagePath: String?
+    var audioPackagePath: String?
+    var prefillCachePackagePath: String?
+    var stepPackagePath: String?
+    var cacheLen: Int?
+    var prefillCacheSeqLen: Int?
+}
+
+enum MossConfigResolver {
+    static func resolve(
+        modelURL: URL,
+        bundleManifestPath: String?,
+        cachePresetName: String?,
+        tokenizerPath: String?,
+        runtimeManifestPath: String?,
+        overrides: MossPackageOverrides,
+        maxNewTokens: Int,
+        audioMaxFrames: Int,
+        computeUnits: MLComputeUnits
+    ) throws -> (
+        config: MossAsrConfig,
+        tokenizerURL: URL?,
+        runtimeManifestURL: URL?
+    ) {
+        var config = MossAsrConfig(
+            maxNewTokens: maxNewTokens,
+            audioMaxFrames: audioMaxFrames,
+            computeUnits: computeUnits
+        )
+        let bundleManifest = try loadBundleManifest(
+            explicitPath: bundleManifestPath,
+            modelURL: modelURL
+        )
+        if let bundleManifest {
+            config.apply(artifacts: bundleManifest.artifacts)
+            if let defaultPreset = bundleManifest.defaultCachePreset,
+               cachePresetName == nil,
+               let preset = bundleManifest.cachePreset(named: defaultPreset)
+            {
+                config.apply(cachePreset: preset)
+            }
+        }
+        if let cachePresetName {
+            if let preset = bundleManifest?.cachePreset(named: cachePresetName) {
+                config.apply(cachePreset: preset)
+            } else {
+                applyHardcodedPreset(cachePresetName, to: &config)
+            }
+        }
+        apply(overrides: overrides, to: &config)
+        return (
+            config,
+            tokenizerPath.map { URL(fileURLWithPath: $0) },
+            runtimeManifestPath.map { URL(fileURLWithPath: $0) }
+        )
+    }
+
+    private static func loadBundleManifest(
+        explicitPath: String?,
+        modelURL: URL
+    ) throws -> MossBundleManifest? {
+        if let explicitPath {
+            return try MossBundleManifest.load(from: URL(fileURLWithPath: explicitPath))
+        }
+        let defaultURL = modelURL.appendingPathComponent(MossBundleManifest.defaultFileName)
+        guard FileManager.default.fileExists(atPath: defaultURL.path) else {
+            return nil
+        }
+        return try MossBundleManifest.load(from: defaultURL)
+    }
+
+    private static func applyHardcodedPreset(_ name: String, to config: inout MossAsrConfig) {
+        var prefillCachePackagePath: String?
+        var prefillCacheSeqLen = config.prefillCacheSeqLen
+        var stepPackagePath: String?
+        var cacheLen = config.cacheLen
+        guard MossCachePreset.apply(
+            name,
+            prefillCachePackagePath: &prefillCachePackagePath,
+            prefillCacheSeqLen: &prefillCacheSeqLen,
+            stepPackagePath: &stepPackagePath,
+            cacheLen: &cacheLen
+        ) else {
+            print("Unknown --cache-preset \(name)")
+            exit(1)
+        }
+        if let prefillCachePackagePath {
+            config.prefillCachePackagePath = prefillCachePackagePath
+        }
+        if let stepPackagePath {
+            config.stepPackagePath = stepPackagePath
+        }
+        config.prefillCacheSeqLen = prefillCacheSeqLen
+        config.cacheLen = cacheLen
+    }
+
+    private static func apply(overrides: MossPackageOverrides, to config: inout MossAsrConfig) {
+        if let value = overrides.tokenPackagePath {
+            config.tokenPackagePath = value
+        }
+        if let value = overrides.audioPackagePath {
+            config.audioPackagePath = value
+        }
+        if let value = overrides.prefillCachePackagePath {
+            config.prefillCachePackagePath = value
+        }
+        if let value = overrides.stepPackagePath {
+            config.stepPackagePath = value
+        }
+        if let value = overrides.cacheLen {
+            config.cacheLen = value
+        }
+        if let value = overrides.prefillCacheSeqLen {
+            config.prefillCacheSeqLen = value
+        }
+    }
+}
+#endif
diff --git a/Sources/FluidAudioCLI/Commands/ASR/MOSS/MossTranscribeCommand.swift b/Sources/FluidAudioCLI/Commands/ASR/MOSS/MossTranscribeCommand.swift
new file mode 100644
index 0000000..2234328
--- /dev/null
+++ b/Sources/FluidAudioCLI/Commands/ASR/MOSS/MossTranscribeCommand.swift
@@ -0,0 +1,229 @@
+#if os(macOS)
+import CoreML
+import FluidAudio
+import Foundation
+
+enum MossTranscribeCommand {
+    static func run(arguments: [String]) async {
+        guard !arguments.isEmpty else {
+            printUsage()
+            exit(1)
+        }
+
+        let audioFile = arguments[0]
+        var modelDir: String?
+        var bundleManifestPath: String?
+        var tokenizerPath: String?
+        var runtimeManifestPath: String?
+        var tokenPackagePath: String?
+        var audioPackagePath: String?
+        var prefillCachePackagePath: String?
+        var stepPackagePath: String?
+        var cachePresetName: String?
+        var cacheLen: Int?
+        var prefillCacheSeqLen: Int?
+        var maxTokens = 160
+        var audioMaxFrames = 3_000
+        var computeUnits: MLComputeUnits = .cpuAndGPU
+        var repeatCount = 1
+
+        var i = 1
+        while i < arguments.count {
+            let arg = arguments[i]
+            switch arg {
+            case "--help", "-h":
+                printUsage()
+                exit(0)
+            case "--model-dir":
+                if i + 1 < arguments.count {
+                    modelDir = arguments[i + 1]
+                    i += 1
+                }
+            case "--bundle-manifest":
+                if i + 1 < arguments.count {
+                    bundleManifestPath = arguments[i + 1]
+                    i += 1
+                }
+            case "--tokenizer":
+                if i + 1 < arguments.count {
+                    tokenizerPath = arguments[i + 1]
+                    i += 1
+                }
+            case "--runtime-manifest":
+                if i + 1 < arguments.count {
+                    runtimeManifestPath = arguments[i + 1]
+                    i += 1
+                }
+            case "--cache-preset":
+                if i + 1 < arguments.count {
+                    cachePresetName = arguments[i + 1]
+                    i += 1
+                }
+            case "--token-package":
+                if i + 1 < arguments.count {
+                    tokenPackagePath = arguments[i + 1]
+                    i += 1
+                }
+            case "--audio-package":
+                if i + 1 < arguments.count {
+                    audioPackagePath = arguments[i + 1]
+                    i += 1
+                }
+            case "--prefill-cache-package":
+                if i + 1 < arguments.count {
+                    prefillCachePackagePath = arguments[i + 1]
+                    i += 1
+                }
+            case "--prefill-cache-seq-len":
+                if i + 1 < arguments.count, let parsed = Int(arguments[i + 1]) {
+                    prefillCacheSeqLen = parsed
+                    i += 1
+                }
+            case "--step-package":
+                if i + 1 < arguments.count {
+                    stepPackagePath = arguments[i + 1]
+                    i += 1
+                }
+            case "--cache-len":
+                if i + 1 < arguments.count, let parsed = Int(arguments[i + 1]) {
+                    cacheLen = parsed
+                    i += 1
+                }
+            case "--max-tokens":
+                if i + 1 < arguments.count, let parsed = Int(arguments[i + 1]) {
+                    maxTokens = parsed
+                    i += 1
+                }
+            case "--audio-max-frames":
+                if i + 1 < arguments.count, let parsed = Int(arguments[i + 1]) {
+                    audioMaxFrames = parsed
+                    i += 1
+                }
+            case "--repeat":
+                if i + 1 < arguments.count, let parsed = Int(arguments[i + 1]) {
+                    repeatCount = max(1, parsed)
+                    i += 1
+                }
+            case "--cpu-only":
+                computeUnits = .cpuOnly
+            case "--cpu-gpu":
+                computeUnits = .cpuAndGPU
+            case "--all":
+                computeUnits = .all
+            default:
+                print("Ignoring unknown option: \(arg)")
+            }
+            i += 1
+        }
+
+        guard let modelDir else {
+            print("Missing --model-dir")
+            printUsage()
+            exit(1)
+        }
+
+        guard #available(macOS 14, iOS 17, *) else {
+            print("MOSS requires macOS 14 or later")
+            exit(1)
+        }
+
+        do {
+            let audioURL = URL(fileURLWithPath: audioFile)
+            let modelURL = URL(fileURLWithPath: modelDir, isDirectory: true)
+            let resolved = try MossConfigResolver.resolve(
+                modelURL: modelURL,
+                bundleManifestPath: bundleManifestPath,
+                cachePresetName: cachePresetName,
+                tokenizerPath: tokenizerPath,
+                runtimeManifestPath: runtimeManifestPath,
+                overrides: MossPackageOverrides(
+                    tokenPackagePath: tokenPackagePath,
+                    audioPackagePath: audioPackagePath,
+                    prefillCachePackagePath: prefillCachePackagePath,
+                    stepPackagePath: stepPackagePath,
+                    cacheLen: cacheLen,
+                    prefillCacheSeqLen: prefillCacheSeqLen
+                ),
+                maxNewTokens: maxTokens,
+                audioMaxFrames: audioMaxFrames,
+                computeUnits: computeUnits
+            )
+
+            let loadStart = CFAbsoluteTimeGetCurrent()
+            let manager = try MossAsrManager.load(
+                from: modelURL,
+                tokenizerURL: resolved.tokenizerURL,
+                runtimeManifestURL: resolved.runtimeManifestURL,
+                config: resolved.config
+            )
+            let loadSeconds = CFAbsoluteTimeGetCurrent() - loadStart
+            for runIndex in 1...repeatCount {
+                let result = try await manager.transcribeDetailed(audioURL: audioURL)
+                print(result.text)
+                fputs(
+                    """
+
+                    MOSS CoreML run \(runIndex)/\(repeatCount)
+                      model load:     \(String(format: "%.3f", loadSeconds))s
+                      audio duration: \(String(format: "%.3f", result.audioDuration))s
+                      processing:     \(String(format: "%.3f", result.processingTime))s
+                      RTFx:           \(String(format: "%.2f", result.rtfx))x
+                      prompt tokens:  \(result.promptLength)
+                      audio tokens:   \(result.audioTokenCount)
+                      generated:      \(result.tokenIds.count)
+                      stopped EOS:    \(result.stoppedOnEos)
+
+                    """,
+                    stderr
+                )
+            }
+        } catch {
+            print("moss-transcribe failed: \(error)")
+            exit(1)
+        }
+    }
+
+    private static func printUsage() {
+        print(
+            """
+            MOSS Transcribe — private CoreML external-cache pipeline
+
+            Usage: fluidaudio moss-transcribe <audio_file> --model-dir <coreml_build_dir> [options]
+
+            Required:
+                --model-dir <path>              Directory containing the compiled MOSS CoreML packages.
+
+            Optional:
+                --bundle-manifest <path>        Optional MOSS bundle manifest. Defaults to <model-dir>/moss_bundle_manifest.json if present.
+                --tokenizer <path>              tokenizer JSON. Defaults to <model-dir>/moss_tokenizer.json.
+                --runtime-manifest <path>       runtime manifest JSON. Defaults to <model-dir>/moss_runtime_manifest.json.
+                --token-package <path>          Token embedding package path relative to --model-dir.
+                --audio-package <path>          Audio encoder package path relative to --model-dir.
+                --cache-preset <name>           Cache package preset. See below.
+                --prefill-cache-package <path>  Prefill cache package path relative to --model-dir.
+                --prefill-cache-seq-len <n>     Prefill cache sequence length. Default: 512.
+                --step-package <path>           Decoder step package path relative to --model-dir.
+                --cache-len <n>                 Decoder cache length. Default: 768.
+                --max-tokens <n>                Max generated tokens. Default: 160.
+                --audio-max-frames <n>          Static audio frames. Default: 3000.
+                --repeat <n>                    Repeat the same file with one loaded manager. Default: 1.
+                --cpu-only                      Force CPU.
+                --cpu-gpu                       CPU + GPU. Default and current known-good setting.
+                --all                           CoreML .all dispatch. The current padded audio package may fail on ANE.
+
+            Current expected package paths under --model-dir:
+                compiled/moss_token_embedding.mlmodelc
+                compiled_audio_30s/moss_audio_encoder_adapter_30s_padded.mlmodelc
+                compiled_prefill_cache_512/moss_decoder_prefill_cache_512.mlmodelc
+                compiled_step_padded/moss_decoder_step_padded_fixture.mlmodelc
+
+            Cache presets:
+            \(MossCachePreset.usage)
+
+            Short-clip 512-cache step package:
+                --step-package compiled_step_padded_512/moss_decoder_step_padded_512.mlmodelc --cache-len 512
+            """
+        )
+    }
+}
+#endif

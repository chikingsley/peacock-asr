@InProceedings{kocmi-EtAl:2022:WMT,
  author    = {Kocmi, Tom  and  Bawden, Rachel  and  Bojar, OndÅ™ej  and  Dvorkovich, Anton  and  Federmann, Christian  and  Fishel, Mark  and  Gowda, Thamme  and  Graham, Yvette  and  Grundkiewicz, Roman  and  Haddow, Barry  and  Knowles, Rebecca  and  Koehn, Philipp  and  Monz, Christof  and  Morishita, Makoto  and  Nagata, Masaaki  and  Nakazawa, Toshiaki  and  NovÃ¡k, Michal  and  Popel, Martin  and  PopoviÄ‡, Maja  and  Shmatova, Mariya},
  title     = {Findings of the 2022 Conference on Machine Translation (WMT22)},
  booktitle      = {Proceedings of the Seventh Conference on Machine Translation},
  month          = {December},
  year           = {2022},
  address        = {Abu Dhabi},
  publisher      = {Association for Computational Linguistics},

# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Virtual environments
.venv/

# Dev tools
.ruff_cache/
.pytest_cache/
.cache/

# Environment
.env

# Logs (keep directory, ignore contents)
logs/*
!logs/.gitkeep

# Model weights (large binaries, download separately)
*.bin
*.pth
*.pt
*.onnx
*.safetensors

# OS
.DS_Store

# wandb local artifacts
wandb/

# Processed features (large Arrow files). Per-project `data` symlinks to external
# storage are ignored by each project's own `.gitignore` (`/data`), which matches
# symlinks too — the trailing-slash rule here only catches real directories.
data/

# Repo-level base/pretrained model cache (large .nemo/.pt weights, copied not symlinked)
base_models/

# Scratch / dry-run outputs
scratch/

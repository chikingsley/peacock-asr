# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Virtual environments
.venv/

# Dev tools
.ruff_cache/
.pytest_cache/
.cache/

# Node / bun (tools/pipeline-tui)
node_modules/
*.tsbuildinfo

# Environment
.env

# Logs (keep directory, ignore contents)
logs/*
!logs/.gitkeep

# Model weights (large binaries, download separately)
*.bin
*.pth
*.pt
*.onnx
*.safetensors

# OS
.DS_Store

# wandb local artifacts
wandb/

# Processed features (large Arrow files). Per-project `data` symlinks to external
# storage are ignored by each project's own `.gitignore` (`/data`), which matches
# symlinks too — the trailing-slash rule here only catches real directories.
data/
# ...but `src/omni_curator/data/` is the curator's SOURCE package (store/sample/export/provenance),
# not artifacts — the bare `data/` above was silently un-tracking the whole data layer (package broke
# on a fresh clone). Re-include the source package.
!/packages/omni-curator/src/omni_curator/data/
!/packages/omni-curator/src/omni_curator/data/**

# Repo-level base/pretrained model cache (large .nemo/.pt weights, copied not symlinked)
base_models/

# Scratch / dry-run outputs
scratch/

# Auto-generated pipeline status snapshot (regenerate with tools/status.py)
STATUS.md

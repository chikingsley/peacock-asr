# Python
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# Virtual environments
.venv/

# Dev tools
.ruff_cache/
.pytest_cache/
.cache/

# Environment
.env

# Logs (keep directory, ignore contents)
logs/*
!logs/.gitkeep

# Model weights (large binaries, download separately)
*.bin
*.pth
*.pt
*.onnx
*.safetensors

# OS
.DS_Store

# wandb local artifacts
wandb/

# Processed features (large Arrow files)
data/

# Per-project data symlinks to machine-specific external storage (/mnt/overflow,
# /mnt/fast-ssd-2tb). The `data/` rule above only matches real dirs, not these
# symlinks, so list them explicitly. (tajik-asr/data is a real in-repo dir.)
/projects/farsi-asr/data
/projects/georgian-asr/data
/projects/russian-asr/data
/projects/dari-asr/data
/projects/common-voice-scripted-speech-25-0/data

# Repo-level base/pretrained model cache (large .nemo/.pt weights, copied not symlinked)
base_models/

# Scratch / dry-run outputs
scratch/
